# Step-1 headless probe: builtin fader edit + verified reverb send, readback, undo, save/reopen.
# Run (paths: replace /Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85 with a scratch directory):
#   MOSH_NO_AUDIO=1 MOSH_SELFTEST_SESSION=_harness/pivot-step1 MOSH_RUN_SCRIPT=<this file> MOSH_RUN_SCRIPT_OUT=/Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85/out.jsonl <Mosh binary> --run-script
{"command":"create_track","args":{"name":"Vocal"},"capture":{"V":"trackId"}}
{"command":"add_test_tone_clip","args":{"trackId":"${V}","seconds":4.0,"freq":220.0}}
{"command":"create_bus","args":{"name":"Reverb"},"capture":{"B":"busNumber","BT":"trackId"}}
{"command":"load_builtin","args":{"trackId":"${BT}","type":"reverb"}}
{"command":"add_send","args":{"trackId":"${V}","bus":"${B}","db":-12}}
{"command":"set_track_volume","args":{"trackId":"${V}","db":-10}}
# Pump once after the fixture: track creation arms the engine's deferred TrackList sort, which is written through the
# UndoManager on the first message pump. Every GUI turn pumps; the headless runner pumps only on __wait, and without this
# line the sort lands after the first undo as a phantom transaction that the second undo consumes (2026-09-05 finding).
{"command":"__wait","args":{"ms":300}}
{"command":"__snapshot","args":{"label":"base"}}
{"command":"export_audio","args":{"file":"/Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85/base.wav","format":"wav","bitDepth":32,"range":"full","tail":"cut"}}
{"command":"batch_begin","args":{"name":"S1","turn_id":"probe-1","source":"probe","utterance":"lower the vocal 3 dB"}}
{"command":"set_track_volume","args":{"trackId":"${V}","db":-13}}
{"command":"batch_end","args":{}}
{"command":"__snapshot","args":{"label":"after_fader"}}
{"command":"set_send_level","args":{"trackId":"${V}","bus":"${B}","db":-18}}
{"command":"__snapshot","args":{"label":"after_send"}}
{"command":"undo","args":{}}
{"command":"__snapshot","args":{"label":"undo_send_immediate"}}
{"command":"__wait","args":{"ms":300}}
{"command":"__snapshot","args":{"label":"undo_send_pumped"}}
{"command":"undo","args":{}}
{"command":"__snapshot","args":{"label":"undo_fader"}}
{"command":"export_audio","args":{"file":"/Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85/undo.wav","format":"wav","bitDepth":32,"range":"full","tail":"cut"}}
{"command":"save_as","args":{"file":"/Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85/step1.mosh"}}
{"command":"open_project","args":{"file":"/Users/emiliosanchez-harris/Mosh/.claude/worktrees/step1-useful-edits/build-macos-arm64-release/green-ccdaab85/step1.mosh"}}
{"command":"__snapshot","args":{"label":"reopened"}}
