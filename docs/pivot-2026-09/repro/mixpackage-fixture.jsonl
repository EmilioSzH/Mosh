# Mix Package v0 deterministic fixture: an unprocessed 32-bit test-tone WAV must survive import -> save_as -> open_project -> export unaltered.
# Run (replace $OUT; create $OUT/fixture-project first):
#   MOSH_NO_AUDIO=1 MOSH_SELFTEST_SESSION=_harness/pivot-fixture MOSH_RUN_SCRIPT=<this file> MOSH_RUN_SCRIPT_OUT=$OUT/out.jsonl <Mosh binary> --run-script
# Pass = sha256(data chunk) of fixture.wav == out.wav AND the imports/ copy AND the consolidated audio/ copy are byte-identical to fixture.wav.
{"command":"create_track","args":{"name":"Tone"},"capture":{"T":"trackId"}}
{"command":"add_test_tone_clip","args":{"trackId":"${T}","seconds":2.0,"freq":220.0}}
{"command":"export_audio","args":{"file":"$OUT/fixture.wav","format":"wav","bitDepth":32,"range":"full","tail":"cut"}}
{"command":"remove_track","args":{"trackId":"${T}"}}
{"command":"create_track","args":{"name":"FIX"},"capture":{"F":"trackId"}}
{"command":"import_clip","args":{"file":"$OUT/fixture.wav","trackId":"${F}","startSeconds":0}}
{"command":"__snapshot","args":{"label":"imported"}}
{"command":"save_as","args":{"file":"$OUT/fixture-project/fixture.mosh"}}
{"command":"open_project","args":{"file":"$OUT/fixture-project/fixture.mosh"}}
{"command":"__snapshot","args":{"label":"reopened"}}
{"command":"export_audio","args":{"file":"$OUT/out.wav","format":"wav","bitDepth":32,"range":"full","tail":"cut"}}
